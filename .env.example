# =============================================================================
#  Vectus SAT — ejemplo de configuración
#  Lo recomendado es NO editar esto a mano: ejecutar ./install.sh, que pregunta
#  cada dato, genera las claves al azar y crea el .env con permisos 600.
#  Si preferís hacerlo manual: cp .env.example .env && nano .env && chmod 600 .env
# =============================================================================

# --- Instancia ---
COMPOSE_PROJECT_NAME=vectus-sat          # nombre de los contenedores
HTTP_PORT=80                             # puerto de la consola web
PUBLIC_URL=http://192.168.1.10           # URL con la que el SOC abre la consola (links de los avisos)
TZ=America/Argentina/Buenos_Aires

# --- Base de datos (no cambiar la clave una vez creada la base) ---
POSTGRES_USER=vectus
POSTGRES_PASSWORD=cambiar-por-una-clave-larga-al-azar
POSTGRES_DB=vectus_sat

# --- Sesiones de la consola ---
JWT_SECRET=cambiar-por-64-caracteres-al-azar   # openssl rand -hex 32
JWT_EXPIRE_HOURS=8

# --- Administrador inicial (se crea solo si la base no tiene usuarios) ---
# No hay contraseñas: se ingresa con un código de 6 dígitos que llega a este correo.
ADMIN_EMAIL=admin@empresa.com

# --- Equipo SOC: reciben el aviso previo (separados por coma; editable en Configuración) ---
SOC_EMAILS=soc@empresa.com

# --- Correo saliente: smtp | graph ---
MAIL_PROVIDER=smtp
# Gmail: smtp.gmail.com / 587 / starttls + contraseña de aplicación de 16 letras
# Otro SMTP: security = starttls (587) | ssl (465) | none
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=cuenta@gmail.com
SMTP_PASSWORD=''
SMTP_FROM=cuenta@gmail.com
SMTP_FROM_NAME="Vectus · Alertas de Seguridad"
# Microsoft 365 con Graph (MAIL_PROVIDER=graph): app de Entra ID con permiso Mail.Send
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=''
GRAPH_SENDER=

# --- Detección ---
NVD_API_KEY=''                           # opcional; acelera la consulta a NVD
ALERT_THRESHOLD=60                       # puntaje para alertar y notificar
MONITOR_THRESHOLD=40                     # puntaje para dejar en monitoreo
KEV_INTERVAL_MIN=15                      # minutos entre consultas a CISA

# --- Avanzado (opcionales) ---
# OTP_TTL_MINUTES=10                     # vigencia del código de ingreso
# MAIL_SEND_PAUSE_SECONDS=1.5            # pausa entre mails (límites de Gmail)
# GOTENBERG_URL=http://gotenberg:3000
